# LandslideGuard AI backend configuration.
# Copy to backend\.env and adjust:   copy .env.example .env
# Every value has a safe default; this file is optional for local development.

ENVIRONMENT=development

# Default: SQLite file backend\landslideguard.db (no setting needed).
# For PostgreSQL (untested) install psycopg[binary] and use e.g.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/landslideguard

# Browser origins allowed to call the API (the Vite dev server proxies /api, so
# this only matters if you serve the frontend from another origin).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Bootstrap admin account (password is re-synced from here on every start).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
# Long random string used to sign admin tokens. Generate one with:
#   .venv\Scripts\python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Rainfall / soil-moisture source for monitored locations:
#   demo       - simulated values, always labelled DEMO (works offline)
#   open-meteo - live model data from api.open-meteo.com (no API key needed);
#                falls back to labelled demo values if the request fails
WEATHER_PROVIDER=open-meteo
HTTP_TIMEOUT_SECONDS=15

# Seed the 46 sample locations, 6 demo citizen reports and a first assessment
# (only into an empty database).
SEED_DEMO_DATA=true

# ---- Citizen incident reporting (accepted from anywhere in India) ----
# Photo limit (MB). Photos are re-encoded (metadata stripped) and become public only after verification.
MAX_UPLOAD_MB=5
# Optional videos (MP4/MOV/WebM/3GP). Not re-encoded, so they are only ever shown to admins.
VIDEO_UPLOADS_ENABLED=true
MAX_VIDEO_MB=25
# Lifetime of the signed links admins use to view photos/videos.
MEDIA_URL_TTL_SECONDS=3600
# Optional official India boundary as GeoJSON (Polygon/MultiPolygon), e.g. from the Survey of India.
# Empty = coordinates are checked against India's bounding box only (see README limitations).
INDIA_BOUNDARY_GEOJSON=
# Show unverified reports on the public incident map (clearly labelled). Photos stay private until verified.
PUBLIC_SHOW_UNVERIFIED=false
# Reports allowed per client IP per hour (0 = no limit).
REPORT_RATE_LIMIT_PER_HOUR=30

# ---- Optional reverse geocoding (suggest state/district/address from coordinates) ----
# "none" (default) or "nominatim". The public Nominatim service requires an identifying
# User-Agent, at most 1 request/second and attribution:
# https://operations.osmfoundation.org/policies/nominatim/
GEOCODER_PROVIDER=none
GEOCODER_URL=https://nominatim.openstreetmap.org/reverse
GEOCODER_USER_AGENT=
GEOCODER_EMAIL=
