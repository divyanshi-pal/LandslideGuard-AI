# LandslideGuard AI frontend configuration. Copy to frontend\.env.local to override.

# Base URL of the FastAPI backend as seen by the browser.
# Leave empty in development: Vite proxies /api to the backend.
VITE_API_BASE_URL=

# Backend address used by the Vite dev-server proxy.
VITE_DEV_BACKEND_URL=http://127.0.0.1:8000

# Map tiles. The default uses the public OpenStreetMap tile server, which is fine for
# development but has a usage policy (https://operations.osmfoundation.org/policies/tiles/).
# Use your own tile server or a commercial provider for production traffic.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
